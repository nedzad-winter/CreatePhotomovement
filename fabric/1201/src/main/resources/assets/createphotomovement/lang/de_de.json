    "itemGroup.createphotomovement": "Create Photomovement",
    "createphotomovement.ponder.solar_generator_basics.header": "Solargenerator Grundlagen",
    "createphotomovement.ponder.solar_generator_basics.text_1": "Der Solargenerator erzeugt Rotationskraft aus Sonnenlicht",
    "createphotomovement.ponder.solar_generator_basics.text_2": "Verbinde Wellen, um die Rotation zu übertragen",
    "createphotomovement.ponder.solar_generator_basics.text_3": "Der Generator braucht direkten Zugang zum Himmel",
    "createphotomovement.ponder.solar_generator_basics.text_4": "Er erzeugt 16 RPM mit 16 SU Kapazität",
    "createphotomovement.ponder.solar_generator_basics.text_5": "Benutze einen Schraubenschlüssel im Schleichen, um die Drehrichtung umzukehren",
    "createphotomovement.ponder.solar_generator_basics.text_6": "Die Rotation dreht sich jetzt in die entgegengesetzte Richtung",
    "createphotomovement.ponder.solar_generator_weather.header": "Wettereffekte",
    "createphotomovement.ponder.solar_generator_weather.text_1": "Bei klarem Wetter läuft der Generator auf voller Geschwindigkeit (16 RPM)",
    "createphotomovement.ponder.solar_generator_weather.text_2": "Bei Regen wird die Leistung auf die Hälfte reduziert (8 RPM)",
    "createphotomovement.ponder.solar_generator_weather.text_3": "Bei Gewitter stoppt der Generator vollständig",
    "createphotomovement.ponder.solar_generator_weather.text_4": "Nachts gibt es nicht genug Licht zur Stromerzeugung",
    "createphotomovement.ponder.solar_generator_obstructions.header": "Hindernisse",
    "createphotomovement.ponder.solar_generator_obstructions.text_1": "Der Solargenerator benötigt direkten Himmelszugang",
    "createphotomovement.ponder.solar_generator_obstructions.text_2": "Feste Blöcke blockieren den Himmelszugang vollständig - Kein Strom!",
    "createphotomovement.ponder.solar_generator_obstructions.text_3": "Glas lässt Licht durch - Strom!",
    "createphotomovement.ponder.solar_generator_obstructions.text_4": "Schneeschichten und Teppiche blockieren den Generator ebenfalls",
    "createphotomovement.ponder.solar_generator_dyeing.header": "Farbvarianten",
    "createphotomovement.ponder.solar_generator_dyeing.text_1": "Solargeneratoren gibt es in 17 Farbvarianten",
    "createphotomovement.ponder.solar_generator_dyeing.text_2": "Rechtsklicke mit einem Farbstoff, um die Farbe zu ändern",
    "createphotomovement.ponder.solar_generator_dyeing.text_3": "Oder crafte einen Generator mit einem Farbstoff in einer Werkbank",
    "createphotomovement.ponder.solar_generator_dyeing.text_4": "Alle Farbvarianten funktionieren identisch",
