    "itemGroup.createphotomovement": "Create Photomovement",
    "createphotomovement.ponder.solar_generator_basics.header": "Solargenerator Grundlagen",
    "createphotomovement.ponder.solar_generator_basics.text_1": "Der Standard-Solargenerator produziert 16 RPM",
    "createphotomovement.ponder.solar_generator_basics.text_2": "Der Erweiterte Solargenerator produziert 32 RPM",
    "createphotomovement.ponder.solar_generator_basics.text_3": "Beide benötigen direkten Zugang zum Himmel",
    "createphotomovement.ponder.horizontal_solar_generator.basics.header": "Horizontaler Solargenerator Grundlagen",
    "createphotomovement.ponder.horizontal_solar_generator.basics.text_1": "Der Horizontale Solargenerator produziert identische RPM und SU wie der Vertikale (16 RPM)",
    "createphotomovement.ponder.horizontal_solar_generator.basics.text_2": "Der Erweiterte Horizontale Solargenerator produziert identische RPM und SU wie der Vertikale (32 RPM)",
    "createphotomovement.ponder.horizontal_solar_generator.basics.text_3": "Beide benötigen direkten Zugang zum Himmel",
    "createphotomovement.ponder.horizontal_solar_generator.directions.header": "Gerichtete Erzeugung",
    "createphotomovement.ponder.horizontal_solar_generator.directions.text_1": "Horizontale Solargeneratoren berechnen SU dynamisch basierend auf Blickrichtung und Tageszeit",
    "createphotomovement.ponder.horizontal_solar_generator.directions.text_2": "Diese reichen von 128 bis 1024 SU für den Standard",
    "createphotomovement.ponder.horizontal_solar_generator.directions.text_3": "Und 256 bis 2048 SU für den Erweiterten",
    "createphotomovement.ponder.horizontal_solar_generator.directions.text_4": "Nach Osten gerichtete Generatoren erreichen ihre maximale Effizienz am Morgen",
    "createphotomovement.ponder.horizontal_solar_generator.directions.text_5": "Nach Westen gerichtete Generatoren erreichen ihre maximale Effizienz am Abend",
    "createphotomovement.ponder.horizontal_solar_generator.directions.text_6": "Nach Norden und Süden gerichtete Generatoren produzieren eine konstant reduzierte Leistung",
    "createphotomovement.ponder.horizontal_solar_generator.directions.text_7": "Standard: 128 SU, Erweitert: 256 SU",
    "createphotomovement.ponder.horizontal_solar_generator.obstructions.header": "Hindernisse",
    "createphotomovement.ponder.horizontal_solar_generator.obstructions.text_1": "Der Generator prüft bis zu 10 Blöcke vor seiner Solarfläche auf Blöcke",
    "createphotomovement.ponder.horizontal_solar_generator.obstructions.text_2": "Wenn kein Block im Weg ist, produziert er seine volle Effizienz",
    "createphotomovement.ponder.horizontal_solar_generator.obstructions.text_3": "Transparente Blöcke beeinträchtigen die Produktion nicht",
    "createphotomovement.ponder.horizontal_solar_generator.obstructions.text_4": "Wenn Sie einen festen Block direkt davor platzieren, produziert der Generator 0",
    "createphotomovement.ponder.horizontal_solar_generator.obstructions.text_5": "Wenn Sie einen festen Block von der 2. bis zur 10. Position haben",
    "createphotomovement.ponder.horizontal_solar_generator.obstructions.text_6": "Der Generator gilt als 'beschattet' und produziert sein Minimum",
    "createphotomovement.ponder.horizontal_solar_generator.obstructions.text_7": "128 SU für den Standard und 256 SU für den Erweiterten",
    "createphotomovement.ponder.horizontal_solar_generator.dyeing.header": "Farbvarianten",
    "createphotomovement.ponder.horizontal_solar_generator.dyeing.text_1": "Sowohl Standard- als auch Erweiterte Horizontale Solargeneratoren können gefärbt werden",
    "createphotomovement.ponder.horizontal_solar_generator.dyeing.text_2": "Rechtsklick mit beliebigem Farbstoff, um die Farbe zu ändern",
    "createphotomovement.ponder.horizontal_solar_generator.dyeing.text_3": "Sie können sie auch mit Farbstoffen herstellen",
    "createphotomovement.ponder.solar_sail.basics.header": "Montage von Solar-Windmühlen",
    "createphotomovement.ponder.solar_sail.basics.text_1": "Solarsegel sind praktische Blöcke, um Solar-Windmühlen zu erstellen",
    "createphotomovement.ponder.solar_sail.basics.text_2": "Sie haften an Blöcken und aneinander ohne Superkleber",
    "createphotomovement.ponder.solar_sail.basics.text_3": "Rechtsklick mit Farbstoff, um sie zu bemalen",
    "createphotomovement.ponder.solar_sail.basics.text_4": "Die Solarsegel produzieren doppelt so viel Energie wie ein regulärer Solargenerator",
    "createphotomovement.ponder.solar_sail.basics.text_5": "8 Solarsegel produzieren 1024 SU, während die Standardsegel 512 SU produzieren",
    "createphotomovement.ponder.solar_sail.advanced.header": "Erweiterte Solar-Windmühlen",
    "createphotomovement.ponder.solar_sail.advanced.text_1": "Das Solar-Windmühlenlager unterstützt alle Segelblöcke",
    "createphotomovement.ponder.solar_sail.advanced.text_2": "Sie können alle Arten von Segeln mischen",
    "createphotomovement.ponder.solar_sail.advanced.text_3": "Die SU-Produktion der Solarsegel und der Standardsegel wird kombiniert",
    "createphotomovement.ponder.solar_sail.advanced.text_4": "Resultierend, in diesem Szenario, in 1536 SU",
    "createphotomovement.ponder.solar_sail.advanced.text_5": "Tagsüber ist die Produktion von Solarsegeln doppelt so hoch wie die von Standardsegeln",
    "createphotomovement.ponder.solar_sail.advanced.text_6": "Bei Regen ist es 50%% mehr als bei den Solarsegeln",
    "createphotomovement.ponder.solar_sail.advanced.text_7": "Bei Nacht und Gewitter produzieren die Solarsegel genauso viel wie die Standardsegel",
    "createphotomovement.ponder.solar_generator_weather.header": "Wettereffekte",
    "createphotomovement.ponder.solar_generator_weather.text_1": "Bei klarem Wetter läuft der Generator mit voller Geschwindigkeit (16 RPM)",
    "createphotomovement.ponder.solar_generator_weather.text_2": "Bei Regen wird die Leistung auf die Hälfte reduziert (8 RPM)",
    "createphotomovement.ponder.solar_generator_weather.text_3": "Bei Gewitter stoppt der Generator komplett",
    "createphotomovement.ponder.solar_generator_weather.text_4": "Nachts gibt es nicht genug Licht, um Energie zu erzeugen",
    "createphotomovement.ponder.solar_generator_obstructions.header": "Hindernisse",
    "createphotomovement.ponder.solar_generator_obstructions.text_1": "Der Solargenerator benötigt direkten Zugang zum Himmel",
    "createphotomovement.ponder.solar_generator_obstructions.text_2": "Feste Blöcke blockieren den Himmelszugang komplett - Kein Strom!",
    "createphotomovement.ponder.solar_generator_obstructions.text_3": "Glas lässt Licht durch - Strom!",
    "createphotomovement.ponder.solar_generator_obstructions.text_4": "Schneeschichten und Teppiche blockieren den Generator ebenfalls",
    "createphotomovement.ponder.solar_generator_dyeing.header": "Farbvarianten",
    "createphotomovement.ponder.solar_generator_dyeing.text_1": "Solargeneratoren gibt es in 17 Farbvarianten",
    "createphotomovement.ponder.solar_generator_dyeing.text_2": "Rechtsklick mit beliebigem Farbstoff, um die Farbe zu ändern",
    "createphotomovement.ponder.solar_generator_dyeing.text_3": "Oder stellen Sie jeden Generator mit einem Farbstoff her",
    "createphotomovement.ponder.solar_generator_dyeing.text_4": "Alle Farbvarianten funktionieren identisch",
